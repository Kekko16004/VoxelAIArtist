<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Voxel AI Artist by KFDev - 3D Viewer & Exporter</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Three.js, OrbitControls & GLTFExporter (for rigged .glb export) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/TransformControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/GLTFExporter.js"></script>

    <style>
        /*
         * ============================================================
         *  TEMA — Design tokens (CSS custom properties)
         *  Default = tema SCURO (glassmorphism). Il tema CHIARO è un
         *  override completo attivato da  <html data-theme="light">.
         *  Cambio tema: document.documentElement.setAttribute('data-theme','light'|'dark')
         *  (vedi applyTheme() / KEYMAP nel <script> in fondo al file).
         *  Aggiungendo un nuovo colore, usa SEMPRE una var qui sotto:
         *  niente colori hardcoded sparsi nel CSS.
         * ============================================================ */
        :root {
            /* Sfondo & superfici */
            --bg-gradient: linear-gradient(135deg, #09070f 0%, #120d24 50%, #05030b 100%);
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.07);
            --glass-border-focus: rgba(99, 102, 241, 0.4);
            /* Superfici di input / inset (barre, campi, contenitori interni) */
            --input-bg: rgba(0, 0, 0, 0.3);
            --input-bg-strong: rgba(0, 0, 0, 0.5);
            --inset-bg: rgba(0, 0, 0, 0.25);
            --overlay-scrim: rgba(10, 10, 12, 0.6);
            /* Stati hover / attivi / tracce */
            --hover-bg: rgba(255, 255, 255, 0.05);
            --hover-bg-strong: rgba(255, 255, 255, 0.1);
            --track-bg: rgba(255, 255, 255, 0.1);
            --thumb-color: #ffffff;
            --swatch-border: rgba(255, 255, 255, 0.2);
            --scrollbar-thumb: rgba(255, 255, 255, 0.15);
            --scrollbar-thumb-hover: rgba(255, 255, 255, 0.3);
            /* Testo */
            --text-primary: #f3f4f6;
            --text-secondary: #9ca3af;
            --text-muted: #9ca3af;
            --text-on-accent: #ffffff;
            /* Accenti */
            --accent-primary: #6366f1;
            --accent-secondary: #ec4899;
            --accent-deep: #4f46e5;
            --accent-cyan: #0ea5e9;
            --accent-soft: rgba(99, 102, 241, 0.25);
            --accent-glow: rgba(99, 102, 241, 0.35);
            --danger: #ef4444;
            /* Ombre */
            --shadow-panel: 10px 0 30px rgba(0, 0, 0, 0.5);
            --shadow-soft: 0 4px 10px rgba(0, 0, 0, 0.3);
            /* Raggi — estetica "voxel": spigoli netti, non morbidi */
            --radius-sm: 3px;
            --radius-md: 5px;
            --radius-lg: 8px;
            --radius-pill: 999px;
            /* Layout */
            --sidebar-width: 380px;
        }

        /* ===== TEMA CHIARO ===== leggibile e ad alto contrasto, non un semplice invert */
        :root[data-theme="light"] {
            --bg-gradient: linear-gradient(135deg, #eef1f8 0%, #e4e8f2 50%, #f5f6fb 100%);
            --glass-bg: rgba(255, 255, 255, 0.6);
            --glass-border: rgba(15, 23, 42, 0.12);
            --glass-border-focus: rgba(99, 102, 241, 0.5);
            --input-bg: rgba(255, 255, 255, 0.75);
            --input-bg-strong: #ffffff;
            --inset-bg: rgba(15, 23, 42, 0.05);
            --overlay-scrim: rgba(226, 230, 240, 0.7);
            --hover-bg: rgba(15, 23, 42, 0.05);
            --hover-bg-strong: rgba(15, 23, 42, 0.1);
            --track-bg: rgba(15, 23, 42, 0.14);
            --thumb-color: #ffffff;
            --swatch-border: rgba(15, 23, 42, 0.2);
            --scrollbar-thumb: rgba(15, 23, 42, 0.2);
            --scrollbar-thumb-hover: rgba(15, 23, 42, 0.35);
            --text-primary: #1e293b;
            --text-secondary: #5b6472;
            --text-muted: #64748b;
            --text-on-accent: #ffffff;
            --shadow-panel: 6px 0 24px rgba(15, 23, 42, 0.12);
            --shadow-soft: 0 4px 10px rgba(15, 23, 42, 0.12);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            color: var(--text-primary);
            overflow: hidden;
            height: 100vh;
            display: flex;
        }

        /* Glassmorphism utility */
        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
        }

        /* Sidebar Layout */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            z-index: 10;
            box-shadow: var(--shadow-panel);
            border-right: 1px solid var(--glass-border);
            overflow: hidden;
            /* tab content scrolls, header/footer stay put */
        }

        /* Tab bar */
        .tab-bar {
            display: flex;
            gap: 4px;
            padding: 4px;
            border-radius: var(--radius-md);
            background: var(--inset-bg);
            border: 1px solid var(--glass-border);
        }

        .tab-btn {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 10px 6px;
            border: none;
            border-radius: var(--radius-sm);
            background: transparent;
            color: var(--text-secondary);
            font-family: inherit;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .tab-btn:hover {
            color: var(--text-primary);
            background: var(--hover-bg);
        }

        .tab-btn.active {
            color: var(--text-on-accent);
            background: linear-gradient(135deg, var(--accent-glow), rgba(236, 72, 153, 0.28));
            box-shadow: 0 2px 10px var(--accent-soft);
        }

        /* Scrollable area that holds the active tab's panels */
        .tab-content {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 18px;
            padding-right: 4px;
            margin-right: -4px;
        }

        .tab-panel {
            display: none;
            flex-direction: column;
            gap: 18px;
        }

        .tab-panel.active {
            display: flex;
            animation: fadeIn 0.25s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(4px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* Pinned footer (export/save) — always visible under the tabs */
        .sidebar-footer {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding-top: 14px;
            border-top: 1px solid var(--glass-border);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        /* Toggle tema chiaro/scuro (in alto a destra nella sidebar) */
        .theme-toggle {
            margin-left: auto;
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            background: var(--hover-bg);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s;
        }

        .theme-toggle:hover {
            background: var(--hover-bg-strong);
            color: var(--text-primary);
        }

        .theme-toggle svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

        /* Mostra il sole nel tema scuro (per passare a chiaro), la luna nel chiaro */
        .theme-toggle .icon-moon { display: none; }
        .theme-toggle .icon-sun { display: block; }
        :root[data-theme="light"] .theme-toggle .icon-sun { display: none; }
        :root[data-theme="light"] .theme-toggle .icon-moon { display: block; }

        /* ===== T6: righe rimappatura scorciatoie ===== */
        .shortcut-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 6px 8px;
            border-radius: var(--radius-sm);
            background: var(--inset-bg);
            border: 1px solid var(--glass-border);
        }

        .shortcut-row .shortcut-label {
            font-size: 12px;
            color: var(--text-primary);
            flex: 1;
        }

        .shortcut-key {
            min-width: 72px;
            text-align: center;
            padding: 5px 10px;
            border-radius: var(--radius-sm);
            background: var(--input-bg);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 11px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            cursor: pointer;
            transition: all 0.2s;
        }

        .shortcut-key:hover {
            background: var(--hover-bg-strong);
            border-color: var(--glass-border-focus);
        }

        .shortcut-key.listening {
            background: var(--accent-soft);
            border-color: var(--accent-primary);
            color: var(--text-on-accent);
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            color: var(--text-on-accent);
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .logo-text {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, var(--text-primary), var(--accent-primary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Titoli di sezione: taglio "tech/voxel" — monospace, maiuscolo, spaziato */
        .section-title {
            font-family: 'Plus Jakarta Sans', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-secondary);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-title::before {
            content: "";
            width: 8px;
            height: 8px;
            background: var(--accent-primary);
            border-radius: 1px;
            box-shadow: 0 0 8px var(--accent-glow);
            flex-shrink: 0;
        }

        /* Drag & Drop Zone */
        .dropzone {
            padding: 24px;
            text-align: center;
            border: 2px dashed var(--glass-border);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--hover-bg);
        }

        .dropzone:hover,
        .dropzone.dragover {
            border-color: var(--accent-primary);
            background: rgba(99, 102, 241, 0.08);
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.1) inset;
        }

        .dropzone p {
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 8px;
        }

        .dropzone svg {
            width: 32px;
            height: 32px;
            stroke: var(--text-secondary);
            transition: stroke 0.3s;
        }

        .dropzone:hover svg {
            stroke: var(--accent-primary);
        }

        /* Controls Panel */
        .controls-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .control-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
        }

        .control-row label {
            color: var(--text-secondary);
        }

        /* Custom Switch */
        .switch {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--track-bg);
            transition: .3s;
            border-radius: var(--radius-pill);
            border: 1px solid var(--glass-border);
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: var(--thumb-color);
            transition: .3s;
            border-radius: 50%;
        }

        input:checked+.slider {
            background-color: var(--accent-primary);
        }

        input:checked+.slider:before {
            transform: translateX(20px);
        }

        /* Slider Inputs */
        input[type="range"] {
            -webkit-appearance: none;
            width: 100px;
            height: 6px;
            border-radius: var(--radius-pill);
            background: var(--track-bg);
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--accent-primary);
            cursor: pointer;
            transition: transform 0.1s;
        }

        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
        }

        #promptInput {
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        #promptInput:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 8px rgba(99, 102, 241, 0.3);
        }

        /*
         * Campi di form generici (input testo/numero, select, textarea).
         * Alcuni campi hanno stili inline con .field: la classe centralizza
         * bg/testo/bordo/raggio in modo che il tema chiaro/scuro funzioni.
         */
        .field {
            background: var(--input-bg) !important;
            color: var(--text-primary) !important;
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            outline: none;
            font-family: inherit;
        }

        .field-strong {
            background: var(--input-bg-strong) !important;
            color: var(--text-primary) !important;
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            outline: none;
            font-family: inherit;
        }

        .field:focus,
        .field-strong:focus {
            border-color: var(--accent-primary);
        }

        /* Focus visibile e coerente su tutti i campi/controlli */
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible,
        button:focus-visible,
        [contenteditable]:focus-visible {
            outline: 2px solid var(--glass-border-focus);
            outline-offset: 1px;
        }

        .meta-card {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .meta-item {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .meta-item.full-width {
            width: 100%;
        }

        .meta-label {
            font-size: 11px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .meta-val {
            font-size: 14px;
            font-weight: 600;
            word-break: break-all;
            white-space: normal;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            width: 100%;
        }

        .meta-grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            width: 100%;
        }

        .meta-divider {
            height: 1px;
            background: var(--glass-border);
            opacity: 0.5;
            margin: 2px 0;
        }

        #sidebarResizer {
            width: 4px;
            cursor: col-resize;
            position: relative;
            z-index: 15;
            background: var(--hover-bg);
            border-left: 1px solid var(--glass-border);
            border-right: 1px solid var(--glass-border);
            transition: background 0.2s, box-shadow 0.2s;
            height: 100vh;
            flex-shrink: 0;
        }

        #sidebarResizer:hover,
        #sidebarResizer.dragging {
            background: var(--accent-primary) !important;
            box-shadow: 0 0 10px var(--accent-primary);
        }

        /* Color Palette Swatches */
        .palette-container {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-height: 120px;
            overflow-y: auto;
            padding: 4px;
        }

        .swatch {
            width: 24px;
            height: 24px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--swatch-border);
            cursor: pointer;
            transition: transform 0.2s;
        }

        .swatch:hover {
            transform: scale(1.15) translateY(-2px);
            box-shadow: var(--shadow-soft);
        }

        /* Tool selector (Edit modes) */
        .tool-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
        }

        .tool-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 10px 4px;
            border-radius: var(--radius-md);
            border: 1px solid var(--glass-border);
            background: var(--hover-bg);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s;
            font-size: 10px;
            font-weight: 600;
        }

        .tool-btn svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .tool-btn:hover {
            background: var(--hover-bg-strong);
            color: var(--text-primary);
        }

        .tool-btn.active {
            background: linear-gradient(135deg, var(--accent-soft), rgba(236, 72, 153, 0.2));
            border-color: var(--glass-border-focus);
            color: var(--text-on-accent);
            box-shadow: 0 0 12px var(--accent-soft);
        }

        .color-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .color-swatch-big {
            width: 38px;
            height: 38px;
            border-radius: var(--radius-md);
            border: 2px solid var(--swatch-border);
            cursor: pointer;
            flex-shrink: 0;
            padding: 0;
            background: none;
        }

        .color-swatch-big::-webkit-color-swatch-wrapper {
            padding: 0;
        }

        .color-swatch-big::-webkit-color-swatch {
            border: none;
            border-radius: var(--radius-sm);
        }

        .hint-text {
            font-size: 11px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        /* Segmented control (rotation mode) */
        .segmented {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
            padding: 4px;
            background: var(--inset-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-md);
        }

        .seg-btn {
            padding: 7px 4px;
            border: none;
            border-radius: var(--radius-sm);
            background: transparent;
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.2s;
        }

        .seg-btn:hover {
            color: var(--text-primary);
            background: var(--hover-bg);
        }

        .seg-btn.active {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-deep));
            color: var(--text-on-accent);
            box-shadow: 0 2px 10px var(--accent-glow);
        }

        /* Rig tab */
        .hint-text {
            font-size: 11px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        .bone-list {
            display: flex;
            flex-direction: column;
            gap: 2px;
            max-height: 220px;
            overflow-y: auto;
        }

        .bone-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 12px;
            color: var(--text-secondary);
            transition: background 0.15s, color 0.15s;
            user-select: none;
        }

        .bone-item:hover {
            background: var(--hover-bg);
            color: var(--text-primary);
        }

        .bone-item.selected {
            background: var(--accent-soft);
            color: var(--text-primary);
        }

        .bone-item.child {
            padding-left: 20px;
        }

        .bone-item.grandchild {
            padding-left: 32px;
        }

        .bone-swatch {
            width: 11px;
            height: 11px;
            border-radius: 2px;
            flex-shrink: 0;
            box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3) inset;
        }

        .bone-count-badge {
            font-size: 10px;
            color: var(--text-secondary);
            margin-left: auto;
            font-variant-numeric: tabular-nums;
        }

        .pose-axis {
            margin-bottom: 10px;
        }

        .pose-axis label {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: var(--text-secondary);
            margin-bottom: 4px;
        }

        .pose-axis input[type=range] {
            width: 100%;
        }

        /* Action Buttons */
        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: auto;
        }

        .btn {
            padding: 12px;
            border: none;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:active {
            transform: translateY(0) scale(0.98);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-deep));
            color: var(--text-on-accent);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

        .btn-primary:hover {
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
            transform: translateY(-1px);
        }

        .btn-secondary {
            background: var(--hover-bg);
            color: var(--text-primary);
            border: 1px solid var(--glass-border);
        }

        .btn-secondary:hover {
            background: var(--hover-bg-strong);
            transform: translateY(-1px);
        }

        /* Canvas Container */
        .canvas-container {
            flex-grow: 1;
            height: 100vh;
            position: relative;
        }

        #canvas3d {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* Gizmo mode switch (top-left scene overlay) */
        #gizmoBar {
            display: none;
        }

        #gizmoBar.visible {
            display: flex;
        }

        .gizmo-btn {
            padding: 7px 12px;
            font-size: 12px;
            font-family: inherit;
            font-weight: 600;
            color: var(--text-secondary);
            background: var(--hover-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .gizmo-btn:hover {
            background: var(--hover-bg-strong);
            color: var(--text-primary);
        }

        .gizmo-btn.active {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-primary));
            color: var(--text-on-accent);
            border-color: transparent;
        }

        /* Floating Tooltip */
        .tooltip {
            position: absolute;
            bottom: 24px;
            right: 24px;
            padding: 12px 18px;
            font-size: 13px;
            color: var(--text-secondary);
            pointer-events: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb);
            border-radius: var(--radius-pill);
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--scrollbar-thumb-hover);
        }

        .spinner {
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-top: 2px solid var(--text-on-accent);
            border-radius: 50%;
            width: 14px;
            height: 14px;
            animation: spin 0.8s linear infinite;
            display: inline-block;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .loader-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
            background: var(--overlay-scrim);
            backdrop-filter: blur(12px);
            transition: all 0.3s ease;
        }

        .loader-content {
            text-align: center;
            color: var(--text-primary);
        }

        .spinner-large {
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-top: 4px solid var(--accent-primary);
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px auto;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.2);
        }

        .loader-text {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .loader-subtext {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.5);
        }

        /* --- Adattività finestra (T4) ---------------------------------------
         * La sidebar ha larghezza fissa (--sidebar-width). Su finestre strette
         * si restringe progressivamente così il canvas resta usabile; sotto una
         * certa soglia la UI si compatta per non rompere il layout. */
        @media (max-width: 1100px) {
            :root { --sidebar-width: 320px; }
        }
        @media (max-width: 900px) {
            :root { --sidebar-width: 280px; }
            .sidebar { padding: 14px; gap: 12px; }
            .tab-btn { font-size: 10px; padding: 8px 4px; }
        }
        @media (max-width: 720px) {
            :root { --sidebar-width: 240px; }
            .sidebar { padding: 10px; gap: 10px; }
            .tab-btn span { display: none; }   /* solo icone su finestre molto strette */
            .section-title { font-size: 11px; }
        }
        /* Finestre basse: garantisce che header/footer non schiaccino il contenuto scrollabile. */
        @media (max-height: 640px) {
            .sidebar { padding-top: 12px; padding-bottom: 12px; gap: 10px; }
        }
    </style>
</head>

<body>

    <!-- Sidebar Control Panel -->
    <div class="sidebar glass">
        <div class="logo-container">
            <div class="logo-icon">V</div>
            <div class="logo-text">Voxel AI Artist <span
                    style="font-size:10px; color:var(--accent-primary); vertical-align: top;">by KFDev</span></div>
            <button id="themeToggleBtn" class="theme-toggle" type="button"
                title="Cambia tema chiaro/scuro" aria-label="Cambia tema chiaro/scuro">
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>
        </div>

        <!-- Tab bar -->
        <div class="tab-bar" id="tabBar">
            <button class="tab-btn active" data-tab="generate">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18M3 12h18" />
                    <path d="M5 5l3 3M19 5l-3 3M5 19l3-3M19 19l-3-3" />
                </svg>
                <span>Genera</span>
            </button>
            <button class="tab-btn" data-tab="view">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                <span>Vista</span>
            </button>
            <button class="tab-btn" data-tab="draw">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 19l7-7 3 3-7 7-3-3z" />
                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
                    <path d="M2 2l7.586 7.586" />
                    <circle cx="11" cy="11" r="2" />
                </svg>
                <span>Disegna</span>
            </button>
            <button class="tab-btn" data-tab="rig">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="4" r="2" />
                    <circle cx="12" cy="20" r="2" />
                    <circle cx="5" cy="11" r="1.6" />
                    <circle cx="19" cy="11" r="1.6" />
                    <path d="M12 6v12M12 9l-6.5 1.6M12 9l6.5 1.6" />
                </svg>
                <span>Rig</span>
            </button>
        </div>

        <!-- Scrollable tab content -->
        <div class="tab-content">
            <!-- ===== TAB: GENERA ===== -->
            <div class="tab-panel active" data-panel="generate">
                <div>
                    <div class="section-title">Generazione Voxel AI</div>
                    <div class="controls-group glass"
                        style="padding: 16px; display: flex; flex-direction: column; gap: 10px;">
                        <input type="text" id="promptInput" class="field" placeholder="Cosa generiamo? (es. Dinosauro)"
                            style="width: 100%; padding: 10px; font-size: 13px;">
                        <div style="display: none; align-items: center; gap: 8px;">
                            <!-- Pulsante immagine temporaneamente disabilitato -->
                            <button class="btn btn-secondary" id="uploadImageBtn" style="padding: 6px 12px; font-size: 11px; display: flex; align-items: center; gap: 6px; flex-shrink: 0;" title="Aggiungi un'immagine di riferimento">
                                📷 Riferimento Foto
                            </button>
                            <input type="file" id="imageInput" accept="image/png, image/jpeg, image/webp" style="display: none;">
                            <div id="imagePreviewContainer" style="display: none; align-items: center; gap: 6px; padding: 4px 8px; border-radius: var(--radius-sm); background: var(--hover-bg); border: 1px solid var(--glass-border); overflow: hidden; flex-grow: 1;">
                                <img id="imagePreview" style="width: 24px; height: 24px; object-fit: cover; border-radius: 4px;" src="">
                                <span id="imageName" style="font-size: 11px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100px;"></span>
                                <button id="removeImageBtn" style="background: transparent; border: none; color: var(--danger); font-size: 14px; cursor: pointer; padding: 0 4px;" title="Rimuovi immagine">×</button>
                            </div>
                        </div>
                        <div class="control-row" style="display: none;">
                            <label>Modello Thinking</label>
                            <label class="switch">
                                <input type="checkbox" id="toggleThinking" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="control-row">
                            <label>Modalità</label>
                            <select id="modeSelect" class="field-strong"
                                style="padding: 6px; font-size: 12px; width: 160px;">
                                <option value="generate" selected>Genera da zero</option>
                                <option value="modify">Modifica esistente</option>
                            </select>
                        </div>
                        <div class="control-row">
                            <label>Modello AI</label>
                            <select id="modelSelect" class="field-strong"
                                style="padding: 6px; font-size: 12px; width: 160px;"></select>
                        </div>
                        <div class="control-row">
                            <label>Dimensione Griglia</label>
                            <select id="gridSelect" class="field-strong"
                                style="padding: 6px; font-size: 12px; width: 160px;">
                                <option value="auto">Auto (Decide l'IA)</option>
                                <option value="32x32x32">32x32x32 (Veloce)</option>
                                <option value="48x48x48">48x48x48 (Media)</option>
                                <option value="64x64x64">64x64x64 (Dettagliato)</option>
                                <option value="128x128x128">128x128x128 (Lento)</option>
                            </select>
                        </div>
                        <button class="btn btn-primary" id="generateBtn"
                            style="width: 100%; font-size: 12px; padding: 10px;">Genera Modello</button>
                    </div>
                </div>

                <!-- Drag & Drop / Upload -->
                <div class="dropzone" id="dropzone">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <p>Trascina il JSON/VoxelAI o clicca qui</p>
                    <input type="file" id="fileInput" accept=".json,.voxelai,.vox,.schem,.schematic" style="display: none;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px; margin-bottom: 8px;">
                    <div style="display: flex; gap: 8px;">
                        <button id="togglePasteBtn" class="btn btn-secondary"
                            style="flex: 1; font-size: 11px; padding: 8px 12px; display: flex; align-items: center; justify-content: center; gap: 6px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" style="width:14px; height:14px;">
                                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2">
                                </path>
                                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                            </svg>
                            Incolla JSON
                        </button>
                        <button id="newProjectBtn" class="btn btn-secondary"
                            style="flex: 1; font-size: 11px; padding: 8px 12px; display: flex; align-items: center; justify-content: center; gap: 6px;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" style="width:14px; height:14px;">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Nuovo Modello
                        </button>
                    </div>
                    <div id="pasteContainer" class="glass"
                        style="display: none; flex-direction: column; gap: 8px; padding: 12px;">
                        <textarea id="pasteTextarea" class="field-strong" placeholder="Incolla qui il codice JSON..."
                            style="width: 100%; height: 100px; padding: 8px; font-family: monospace; font-size: 11px; resize: vertical;"></textarea>
                        <div style="display: flex; gap: 8px; justify-content: flex-end;">
                            <button id="cancelPasteBtn" class="btn btn-secondary"
                                style="padding: 4px 10px; font-size: 11px; font-weight: 500;">Annulla</button>
                            <button id="submitPasteBtn" class="btn btn-primary"
                                style="padding: 4px 12px; font-size: 11px; font-weight: 600;">Carica</button>
                        </div>
                    </div>
                    <div id="newProjectContainer" class="glass"
                        style="display: none; flex-direction: column; gap: 8px; padding: 12px;">
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <label
                                style="font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Nome
                                Modello</label>
                            <input type="text" id="newProjectName" class="field-strong" value="Nuovo_Modello"
                                style="width: 100%; padding: 6px; font-size: 11px;">
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <label
                                style="font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Dimensione
                                Griglia</label>
                            <select id="newProjectGrid" class="field-strong"
                                style="width: 100%; padding: 6px; font-size: 11px;">
                                <option value="16,16,16">16x16x16 (Piccola)</option>
                                <option value="32,32,32">32x32x32 (Standard)</option>
                                <option value="48,48,48">48x48x48 (Media)</option>
                                <option value="64,64,64" selected>64x64x64 (Grande)</option>
                                <option value="128,128,128">128x128x128 (Molto Grande)</option>
                            </select>
                        </div>
                        <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 4px;">
                            <button id="cancelNewProjectBtn" class="btn btn-secondary"
                                style="padding: 4px 10px; font-size: 11px; font-weight: 500;">Annulla</button>
                            <button id="submitNewProjectBtn" class="btn btn-primary"
                                style="padding: 4px 12px; font-size: 11px; font-weight: 600;">Crea</button>
                        </div>
                    </div>
                </div>

                <!-- Metadata Section -->
                <div>
                    <div class="section-title">Informazioni Modello</div>
                    <div class="meta-card glass">
                        <div class="meta-item full-width">
                            <span class="meta-label">Nome</span>
                            <span class="meta-val" id="modelName" contenteditable="true" title="Clicca per rinominare"
                                style="cursor: text; border-bottom: 1px dashed var(--glass-border); padding-bottom: 2px;">Nessuno</span>
                        </div>

                        <div class="meta-divider"></div>

                        <div class="meta-row">
                            <div class="meta-item">
                                <span class="meta-label">Dimensione Griglia</span>
                            </div>
                            <div style="display:flex; gap: 4px; align-items: center;">
                                <input type="text" id="gridSizeEdit" class="field-strong" value="64,64,64"
                                    style="width: 70px; padding: 2px 4px; font-size: 11px; text-align: center;">
                                <button id="applyGridBtn"
                                    style="padding: 2px 6px; font-size: 10px; background: var(--hover-bg-strong); border: 1px solid var(--glass-border); color: var(--text-primary); border-radius: var(--radius-sm); cursor: pointer;">Applica</button>
                            </div>
                        </div>

                        <div class="meta-divider"></div>

                        <div class="meta-grid-2col">
                            <div class="meta-item">
                                <span class="meta-label">Voxel Totali</span>
                                <span class="meta-val" id="voxelCount">0</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">Voxel Visibili</span>
                                <span class="meta-val" id="visibleCount">0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== TAB: VISTA ===== -->
            <div class="tab-panel" data-panel="view">
                <div>
                    <div class="section-title">Opzioni di Visualizzazione</div>
                    <div class="controls-group glass" style="padding: 16px;">
                        <div class="control-row">
                            <label>Mostra Griglia Guida</label>
                            <label class="switch">
                                <input type="checkbox" id="toggleGrid" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="control-row" style="align-items: flex-start; flex-direction: column; gap: 8px;">
                            <label>Rotazione</label>
                            <div class="segmented" id="rotationModes">
                                <button class="seg-btn active" data-rot="none"
                                    title="Nessuna rotazione automatica">Nessuna</button>
                                <button class="seg-btn" data-rot="object"
                                    title="L'oggetto ruota su se stesso (giradischi)">Oggetto</button>
                                <button class="seg-btn" data-rot="orbit"
                                    title="La camera orbita fluidamente attorno all'oggetto (stile The Finals)">Camera</button>
                            </div>
                            <input type="range" id="rotationSpeed" min="0.2" max="3" step="0.1" value="1"
                                title="Velocità di rotazione" style="width:100%;">
                        </div>
                        <div class="control-row">
                            <label>Wireframe</label>
                            <label class="switch">
                                <input type="checkbox" id="toggleWireframe">
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="control-row">
                            <label>Spazio Voxel (Gap)</label>
                            <input type="range" id="voxelGap" min="0" max="0.1" step="0.01" value="0">
                        </div>
                    </div>
                </div>

                <!-- ===== T1 Fase B: Outliner Oggetti ===== -->
                <div>
                    <div class="section-title">Oggetti della Scena</div>
                    <div class="controls-group glass" id="objectsPanel" style="padding: 14px; display:flex; flex-direction:column; gap:10px;">
                        <div style="font-size:11px; color:var(--text-muted, #9ca3af); line-height:1.4;">
                            Premi <b>Tab</b> per passare da Modifica a Oggetto. In Modalità Oggetto clicca un oggetto per selezionarlo.
                        </div>
                        <div id="objectsList" style="display:flex; flex-direction:column; gap:4px; max-height:220px; overflow-y:auto;">
                            <!-- Righe oggetto iniettate qui -->
                        </div>
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            <button class="btn btn-secondary" id="objNewBtn" style="flex:1 1 45%; font-size:11px; padding:8px 6px;" title="Aggiungi un nuovo oggetto vuoto">＋ Nuovo</button>
                            <button class="btn btn-secondary" id="objDuplicateBtn" style="flex:1 1 45%; font-size:11px; padding:8px 6px;" title="Duplica l'oggetto attivo">⧉ Duplica</button>
                            <button class="btn btn-secondary" id="objRenameBtn" style="flex:1 1 45%; font-size:11px; padding:8px 6px;" title="Rinomina l'oggetto attivo">✎ Rinomina</button>
                            <button class="btn btn-secondary" id="objMergeBtn" style="flex:1 1 45%; font-size:11px; padding:8px 6px;" title="Unisce gli oggetti spuntati in uno solo">⛓ Unisci</button>
                            <button class="btn btn-secondary" id="objDeleteBtn" style="flex:1 1 100%; font-size:11px; padding:8px 6px; color:var(--accent-pink, #ec4899);" title="Elimina l'oggetto attivo">🗑 Elimina attivo</button>
                        </div>
                    </div>
                </div>

                <!-- Palette Section -->
                <div>
                    <div class="section-title">Palette Colori</div>
                    <div class="palette-container glass" id="palette">
                        <!-- Color swatches injected here -->
                    </div>
                </div>

                <!-- ===== T6: Scorciatoie da tastiera (rimappabili) ===== -->
                <div>
                    <div class="section-title">Scorciatoie da tastiera</div>
                    <div class="controls-group glass" id="shortcutsPanel" style="padding: 14px; display:flex; flex-direction:column; gap:8px;">
                        <div style="font-size:11px; color:var(--text-muted, #9ca3af); line-height:1.4;">
                            Clicca il tasto accanto a un'azione, poi premi la nuova combinazione. <b>Esc</b> annulla.
                        </div>
                        <div id="shortcutsList" style="display:flex; flex-direction:column; gap:4px;">
                            <!-- Righe scorciatoia iniettate qui -->
                        </div>
                        <div id="shortcutConflict" style="display:none; font-size:11px; color:var(--danger, #ef4444); line-height:1.4; padding:4px 0;"></div>
                        <div style="display:flex; gap:6px;">
                            <button class="btn btn-secondary" id="shortcutsResetBtn" style="flex:1; font-size:11px; padding:8px 6px;" title="Ripristina tutte le scorciatoie ai valori predefiniti">↺ Ripristina predefiniti</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== TAB: DISEGNA ===== -->
            <div class="tab-panel" data-panel="draw">
                <div>
                    <div class="section-title">Strumenti di Modifica</div>
                    <div class="controls-group glass" style="padding: 16px;">
                        <div class="tool-grid">
                            <button class="tool-btn active" id="toolView" data-tool="view"
                                title="Solo visualizzazione (nessuna modifica)">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <span>Vista</span>
                            </button>
                            <button class="tool-btn" id="toolPlace" data-tool="place"
                                title="Aggiungi voxel (clic sinistro)">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19" />
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                </svg>
                                <span>Aggiungi</span>
                            </button>

                            <button class="tool-btn" id="toolDraw" data-tool="draw"
                                title="Disegna: ricolora i voxel col colore attivo (tieni premuto e trascina)">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M12 19l7-7 3 3-7 7-3-3z" />
                                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
                                    <path d="M2 2l7.586 7.586" />
                                    <circle cx="11" cy="11" r="2" />
                                </svg>
                                <span>Disegna</span>
                            </button>
                            <button class="tool-btn" id="toolPick" data-tool="pick"
                                title="Contagocce: preleva il colore di un voxel">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M2 22l4-1 12-12-3-3L3 18l-1 4z" />
                                    <path d="M15 5l3 3" />
                                    <path d="M18 2l4 4-3 3-4-4z" />
                                </svg>
                                <span>Contagocce</span>
                            </button>
                        </div>
                        <div class="btn-group" style="margin-top:8px; grid-template-columns:1fr 1fr;">
                            <button class="btn btn-secondary" id="clearAllBtn" style="padding:4px; font-size:11px;"
                                title="Rimuove tutti i voxel">Svuota Tutto</button>
                            <button class="btn btn-secondary" id="fillFloorBtn" style="padding:4px; font-size:11px;"
                                title="Riempie il piano base col colore attivo">Riempi Piano</button>
                        </div>
                        <div class="control-row" style="margin-top: 8px;">
                            <label>Colore Attivo</label>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span id="activeColorHex"
                                    style="font-size:12px; color:var(--text-secondary); font-variant-numeric:tabular-nums;">#6366F1</span>
                                <input type="color" id="activeColor" value="#6366f1" class="color-input"
                                    title="Scegli il colore da posare">
                            </div>
                        </div>
                        <div class="control-row" style="margin-top: 4px;">
                            <label
                                title="Raggio del pennello: 1 = un solo voxel, valori maggiori agiscono su una sfera di voxel">Dimensione
                                pennello <span id="brushSizeVal"
                                    style="color:var(--text-secondary); font-weight:400;">1</span></label>
                            <input type="range" id="brushSize" min="1" max="6" step="1" value="1" style="width:120px;">
                        </div>
                        <div class="control-row" style="margin-top: 4px;">
                            <label
                                title="Ogni modifica viene replicata specularmente rispetto al centro del modello sull'asse scelto">Simmetria</label>
                            <div class="segmented" id="symmetryAxis">
                                <button class="seg-btn active" data-sym="none" title="Nessuna simmetria">Off</button>
                                <button class="seg-btn" data-sym="x" title="Specchia sull'asse X">X</button>
                                <button class="seg-btn" data-sym="y" title="Specchia sull'asse Y">Y</button>
                                <button class="seg-btn" data-sym="z" title="Specchia sull'asse Z">Z</button>
                            </div>
                        </div>
                        <div class="control-row" style="margin-top: 4px;">
                            <label title="Blocca il trascinamento dell'area su un asse specifico (piano fisso). Premi Q durante il drag per ciclare.">Piano Drag</label>
                            <div class="segmented" id="dragAxisSelect">
                                <button class="seg-btn active" data-axis="auto" title="Auto: basato sulla faccia cliccata">Auto</button>
                                <button class="seg-btn" data-axis="x" title="Piano YZ (Larghezza X fissa)">X</button>
                                <button class="seg-btn" data-axis="y" title="Piano XZ (Altezza Y fissa)">Y</button>
                                <button class="seg-btn" data-axis="z" title="Piano XY (Profondità Z fissa)">Z</button>
                            </div>
                        </div>
                        <p id="editHint"
                            style="font-size:11px; color:var(--text-secondary); line-height:1.5; margin-top:2px;">
                            Modalità Vista: trascina per orbitare. Scegli uno strumento per modificare il modello.
                        </p>
                        <div class="btn-group" style="margin-top:4px; grid-template-columns:1fr 1fr;">
                            <button class="btn btn-secondary" id="undoBtn" disabled
                                style="padding:8px; font-size:12px;">↶ Annulla</button>
                            <button class="btn btn-secondary" id="redoBtn" disabled
                                style="padding:8px; font-size:12px;">↷ Ripeti</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== TAB: RIG ===== -->
            <div class="tab-panel" data-panel="rig">
                <div>
                    <div class="section-title">Scheletro & Rigging</div>
                    <div class="controls-group glass" style="padding: 16px;">
                        <div class="control-row" style="align-items:flex-start; flex-direction:column; gap:8px;">
                            <label>Tipo di scheletro</label>
                            <div class="segmented" id="rigType">
                                <button class="seg-btn active" data-rig="humanoid"
                                    title="Bipede: testa, busto, braccia, gambe">Umanoide</button>
                                <button class="seg-btn" data-rig="generic"
                                    title="Catena di ossa lungo l'asse principale (animali, armi, oggetti)">Generico</button>
                            </div>
                        </div>
                        <button class="btn btn-primary" id="autoRigBtn"
                            style="width:100%; font-size:12px; padding:10px; margin-top:4px;">
                            🦴 Auto-Rig
                        </button>
                        <div class="control-row">
                            <label title="Mostra le ossa sovrapposte al modello">Mostra scheletro</label>
                            <label class="switch">
                                <input type="checkbox" id="toggleSkeleton" checked>
                                <span class="slider"></span>
                            </label>
                        </div>
                        <div class="control-row">
                            <label title="Colora ogni voxel in base all'osso che lo controlla">Colora pesi per
                                osso</label>
                            <label class="switch">
                                <input type="checkbox" id="toggleWeightColors">
                                <span class="slider"></span>
                            </label>
                        </div>
                        <p id="rigHint" class="hint-text" style="margin-top:2px;">
                            Nessun rig. Premi Auto-Rig per generare uno scheletro con pesi rigidi (ogni voxel segue un
                            solo osso, così i cubi non si deformano).
                        </p>
                    </div>
                </div>

                <div id="rigDetails" style="display:none;">
                    <div class="section-title" style="margin-top:16px;">Ossa <span id="boneCount"
                            style="color:var(--text-secondary); font-weight:400;"></span></div>
                    <div class="controls-group glass" style="padding:12px;">
                        <div id="boneList" class="bone-list"></div>
                    </div>

                    <div class="section-title" style="margin-top:16px;">Posa osso selezionato</div>
                    <div class="controls-group glass" style="padding:16px;">
                        <div id="poseControls">
                            <div class="pose-axis"><label>Rot X <span id="rotXVal">0°</span></label><input type="range"
                                    id="poseRotX" min="-180" max="180" step="1" value="0"></div>
                            <div class="pose-axis"><label>Rot Y <span id="rotYVal">0°</span></label><input type="range"
                                    id="poseRotY" min="-180" max="180" step="1" value="0"></div>
                            <div class="pose-axis"><label>Rot Z <span id="rotZVal">0°</span></label><input type="range"
                                    id="poseRotZ" min="-180" max="180" step="1" value="0"></div>
                        </div>
                        <button class="btn btn-secondary" id="resetPoseBtn"
                            style="width:100%; padding:8px; font-size:12px; margin-top:8px;">↺ Riporta a T-pose</button>
                    </div>

                    <div class="section-title" style="margin-top:16px;">Animazioni</div>
                    <div class="controls-group glass" style="padding:16px;">
                        <div class="control-row">
                            <label>Clip</label>
                            <select id="animSelect" class="field-strong"
                                style="padding:6px; font-size:12px; width:150px;">
                                <option value="none">Nessuna (posa fissa)</option>
                                <option value="idle">Idle (respiro)</option>
                                <option value="walk">Camminata</option>
                                <option value="run">Corsa</option>
                                <option value="jump">Salto</option>
                                <option value="wave">Saluto</option>
                            </select>
                        </div>
                        <p class="hint-text" style="margin-top:8px;">Le clip sono generate dallo scheletro e servono per
                            l'anteprima. Vengono incluse nell'export GLB.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pinned footer: export / save always visible -->
        <div class="sidebar-footer">
            <div style="display: flex; gap: 10px;">
                <button class="btn btn-primary" id="saveProjectBtn" style="flex: 1; font-size: 11px; padding: 10px 5px;"
                    title="Salva il progetto nativo (.voxai) — intera scena">
                    💾 Salva progetto (.voxai)
                </button>
                <button class="btn btn-secondary" id="saveProjectAsBtn"
                    style="flex: 1; font-size: 11px; padding: 10px 5px;" title="Salva il progetto con un nuovo nome (.voxai)">
                    Salva con nome…
                </button>
            </div>
            <div style="display: flex; gap: 10px;">
                <button class="btn btn-secondary" id="openProjectBtn" style="flex: 1; font-size: 11px; padding: 10px 5px;"
                    title="Apri un progetto (.voxai / .json / .vox / .schem)">
                    📂 Apri progetto…
                </button>
                <button class="btn btn-secondary" id="autosaveHistoryBtn"
                    style="flex: 1; font-size: 11px; padding: 10px 5px;" title="Mostra la cronologia dei salvataggi automatici">
                    🕒 Cronologia salvataggi
                </button>
            </div>
            <div id="autosaveStatus" style="font-size: 10px; opacity: 0.65; text-align: center; min-height: 12px;"></div>
            <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                <button class="btn btn-secondary" id="saveJsonBtn" style="flex: 1; font-size: 11px; padding: 10px 5px;"
                    title="Salva come file VoxelAI crittografato (.voxelai)">
                    💾 Salva VoxelAI
                </button>
                <button class="btn btn-secondary" id="savePlainJsonBtn"
                    style="flex: 1; font-size: 11px; padding: 10px 5px;" title="Salva come file JSON in chiaro (.json)">
                    💾 Salva JSON
                </button>
            </div>
            <div class="btn-group">
                <button class="btn btn-secondary" id="exportMtlBtn">
                    Esporta MTL
                </button>
                <button class="btn btn-primary" id="exportObjBtn">
                    Esporta OBJ
                </button>
            </div>
            <div class="btn-group" style="margin-top:10px;">
                <button class="btn btn-secondary" id="exportVoxBtn"
                    title="Esporta in formato MagicaVoxel (.vox)">
                    Esporta .vox
                </button>
                <button class="btn btn-secondary" id="exportSchemBtn"
                    title="Esporta in formato Minecraft Sponge Schematic (.schem) per WorldEdit/Litematica">
                    Esporta .schem (Minecraft)
                </button>
            </div>
            <button class="btn btn-primary" id="exportGlbBtn"
                style="width:100%; margin-top:10px; background:linear-gradient(135deg,var(--accent-cyan),var(--accent-primary));"
                title="Esporta GLB con scheletro e pesi rigidi (per Blender/Unity/Godot). Se non c'è rig, esporta il modello statico.">
                Esporta GLB (riggato) ↓
            </button>
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 11px; color: var(--text-muted, #9ca3af);">
                <input type="checkbox" id="glbScaleCheckbox" checked style="cursor: pointer; accent-color: var(--accent, #6366f1);">
                <label for="glbScaleCheckbox" style="cursor: pointer; user-select: none;">Autoscale GLB 1/100 (Unity/Blender)</label>
            </div>
            <details id="animHelp"
                style="margin-top:8px; font-size:12px; line-height:1.5; color:var(--text-muted, #9ca3af);">
                <summary style="cursor:pointer; color:var(--text, #e5e7eb);">Non vedi le animazioni in Blender?
                </summary>
                <p style="margin:6px 0 4px;">Le animazioni (<b>idle, walk, run, jump, wave</b>) sono <b>già dentro il
                        .glb</b>: Blender le importa come <i>Actions</i>, ma non ne assegna una in automatico, così la
                    timeline sembra vuota. Per vederle:</p>
                <ol style="margin:0; padding-left:18px;">
                    <li>Seleziona l'<b>Armature</b> nell'outliner.</li>
                    <li>Apri un editor <b>Dope Sheet</b> e passa alla modalità <b>Action Editor</b>.</li>
                    <li>Clicca il menu <b>Browse Action</b> (l'icona a sinistra del nome) e scegli <b>walk</b> /
                        <b>run</b> / ecc.
                    </li>
                    <li>Premi <b>Spazio</b> per riprodurre.</li>
                </ol>
                <p style="margin:4px 0 0;">In alternativa usa l'editor <b>Nonlinear Animation (NLA)</b>: lì trovi tutte
                    le azioni pronte da trascinare.</p>
            </details>
        </div>
    </div>

    <div id="sidebarResizer"></div>

    <!-- Main Canvas viewport -->
    <div class="canvas-container">
        <canvas id="canvas3d"></canvas>
        <!-- Gizmo mode switch: only shown while a rig is active on the rig tab. -->
        <div id="gizmoBar" class="glass"
            style="position:absolute; top:14px; left:14px; z-index:20; gap:6px; padding:6px; border-radius:10px;">
            <button id="gizmoRotateBtn" class="gizmo-btn active" title="Ruota osso — posa (R)">⟳ Ruota</button>
            <button id="gizmoTranslateBtn" class="gizmo-btn" title="Sposta giunto — modifica scheletro (G)">✥
                Sposta</button>
        </div>
        <div id="loaderOverlay" class="loader-overlay glass" style="display: none;">
            <div class="loader-content">
                <div class="spinner-large"></div>
                <div class="loader-text">Generazione del modello 3D in corso...</div>
                <div class="loader-subtext">Attendere circa 1-2 minuti. L'AI sta creando i voxel.</div>
            </div>
        </div>
        <!-- <div class="tooltip glass" id="viewTooltip">
            Vista: Sinistro Ruota · Destro Pan · Rotella Zoom &nbsp;|&nbsp; Modifica: Sinistro Agisce · Destro Ruota
        </div> -->
        <!-- T1 Fase B: indicatore modalità Oggetto/Modifica -->
        <div id="editorModeBadge" class="glass"
             style="position:absolute; top:14px; right:14px; z-index:20; padding:8px 14px; border-radius:var(--radius-md, 10px); font-size:12px; font-weight:600; color:var(--text-primary, #e5e7eb); letter-spacing:0.03em; pointer-events:none; border:1px solid var(--glass-border, rgba(255,255,255,0.12)); box-shadow:0 8px 32px rgba(0,0,0,0.4); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);">
            Modalità Modifica
        </div>
        <!-- HUD display for box-drag axis constraint -->
        <div id="dragConstraintHUD" class="glass"
             style="display:none; position:absolute; bottom:20px; left:50%; transform:translateX(-50%); z-index:20; padding:10px 18px; border-radius:var(--radius-md); font-size:12px; font-weight:600; color:var(--text-primary); letter-spacing:0.03em; pointer-events:none; border:1px solid var(--glass-border); box-shadow:0 8px 32px rgba(0,0,0,0.5); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);">
        </div>
        <!-- HUD per l'estrusione facce (tasto E) -->
        <div id="extrudeHUD" class="glass"
             style="display:none; position:absolute; bottom:64px; left:50%; transform:translateX(-50%); z-index:20; padding:10px 18px; border-radius:var(--radius-md); font-size:12px; font-weight:600; color:var(--text-primary); letter-spacing:0.03em; pointer-events:none; border:1px solid var(--glass-border); box-shadow:0 8px 32px rgba(0,0,0,0.5); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);">
        </div>
        <!-- T-progetto: pannello "Cronologia salvataggi" (ripristino autosave) -->
        <div id="autosaveHistoryOverlay"
             style="display:none; position:absolute; inset:0; z-index:40; align-items:center; justify-content:center; background:var(--overlay-scrim);">
            <div class="glass" style="width:min(460px, 90%); max-height:80%; display:flex; flex-direction:column; padding:18px; border-radius:var(--radius-md); border:1px solid var(--glass-border); box-shadow:0 12px 48px rgba(0,0,0,0.5);">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                    <div style="font-size:15px; font-weight:700; color:var(--text-primary);">Cronologia salvataggi</div>
                    <button class="btn btn-secondary" id="autosaveHistoryClose" style="font-size:12px; padding:6px 12px;">Chiudi</button>
                </div>
                <div id="autosaveList" style="overflow-y:auto; flex:1; margin-bottom:12px;"></div>
                <button class="btn btn-secondary" id="autosaveOpenFolderBtn" style="width:100%; font-size:12px; padding:8px;"
                    title="Apri la cartella dei salvataggi automatici">📁 Apri cartella autosave</button>
            </div>
        </div>
    </div>

    <script>
<!--BUNDLE-->
    </script>
</body>

</html>