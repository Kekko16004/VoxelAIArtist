# ===== VoxelAIArtist — file da NON versionare =====

# --- CREDENZIALI (mai committare) ---
# token.txt e cookies.json contengono token di sessione. Se sono gia' finiti in
# git, rimuoverli dall'index NON li rende sicuri: vanno anche REVOCATI/rigenerati
# lato servizio, perche' restano leggibili nella storia dei commit.
token.txt
cookies.json
*.cookies.json
.env
.env.*
secrets.json

# --- Bytecode Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Ambienti virtuali ---
.venv/
venv/
env/
ENV/

# --- Artefatti di build PyInstaller ---
build/
dist/
*.spec.bak

# --- Backup e snapshot di lavoro ---
# Le copie .bak / .tar.gz sono utili in locale ma pesano nel repo e sono
# ricostruibili: la storia di git E' il sistema di backup.
.claude/backups/
# Worktree isolati creati da Claude Code: copie di lavoro del repo, non
# contenuto del repo. Senza questa riga finirebbero nell'indice per intero.
.claude/worktrees/
# Scratch di subagent-driven-development (ledger, brief, pacchetti di review):
# artefatti di processo rigenerabili, la storia git e' il record definitivo.
.superpowers/
*.bak
*.orig
*.rej

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Log e temporanei ---
*.log
tmp/
temp/

# Artefatti temporanei dei test
tests/.js_out.json
tests/.js_budget.json
tests/.js_pixel_out.json
tests/.bundle_check.js
# three.js + GLTFExporter scaricati a mano per l'harness GLB, e i .glb che
# genera: ~35 MB rigenerabili, non vanno nella storia del repo.
tests/.vendor/
# Output degli strumenti diagnostici (.glb_export_harness, .blender_*): binari
# di lavoro rigenerabili con un comando, non risultati da conservare.
tests/*.glb
tests/*.glb.expect.json
tests/*.png
